{
  "manifest_version": 3,
  "name": "Freeze",
  "version": "1.1.0",
  "description": "Freeze, thaw, or rewind media across every open tab.",
  "permissions": ["tabs", "scripting", "storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Freeze — click to freeze/thaw; right-click to rewind",
    "default_icon": {
      "16": "icons/freeze-16.png",
      "32": "icons/freeze-32.png",
      "48": "icons/freeze-48.png",
      "128": "icons/freeze-128.png"
    }
  },
  "commands": {
    "toggle-freeze": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Freeze or thaw all media"
    },
    "rewind-all": {
      "suggested_key": {
        "default": "Alt+Shift+0"
      },
      "description": "Rewind all media to 0:00"
    }
  },
  "icons": {
    "16": "icons/freeze-16.png",
    "32": "icons/freeze-32.png",
    "48": "icons/freeze-48.png",
    "128": "icons/freeze-128.png"
  }
}
