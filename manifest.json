{
  "manifest_version": 3,
  "name": "Freeze",
  "version": "1.0.0",
  "description": "One click pauses playing video and audio — especially YouTube — across every open tab. Click again to thaw only what Freeze paused.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Freeze — click to pause all media in every tab",
    "default_icon": {
      "16": "icons/freeze-16.png",
      "32": "icons/freeze-32.png",
      "48": "icons/freeze-48.png",
      "128": "icons/freeze-128.png"
    }
  },
  "icons": {
    "16": "icons/freeze-16.png",
    "32": "icons/freeze-32.png",
    "48": "icons/freeze-48.png",
    "128": "icons/freeze-128.png"
  }
}
